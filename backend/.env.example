# PostgreSQL Async Connection URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/onderadb

# Anthropic Claude API Key (Required for Claude Agronomic Orchestrator)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude Model Selection
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ondera-agro-mesh.vercel.app

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
